---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/assets/mortgage-compass-card.svg",
  type = "website",
  noindex = false,
  jsonLd
} = Astro.props;
const fullTitle = title.includes("Mortgage Compass") ? title : `${title} | Mortgage Compass`;
const canonicalUrl = new URL(canonical, SITE.origin).toString();
const imageUrl = new URL(image, SITE.origin).toString();
const segmentLabels: Record<string, string> = {
  calculators: "Calculators",
  guides: "Guides",
  housing: "City housing data",
  about: "About",
  methodology: "Methodology",
  privacy: "Privacy",
  terms: "Terms",
  contact: "Contact",
};
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  { label: "Home", href: pathSegments.length ? "/" : undefined },
  ...pathSegments.map((segment, index) => {
    const isCurrent = index === pathSegments.length - 1;
    const path = `/${pathSegments.slice(0, index + 1).join("/")}/`;
    return {
      label: isCurrent
        ? title.replace(/\s+\|\s+Mortgage Compass$/, "")
        : (segmentLabels[segment] ?? segment.replaceAll("-", " ")),
      href: isCurrent ? undefined : path,
    };
  }),
];
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: fullTitle,
  description,
  url: canonicalUrl,
  inLanguage: SITE.locale,
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.origin,
  },
};
const breadcrumbSchema = pathSegments.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        item: new URL(item.href ?? Astro.url.pathname, SITE.origin).toString(),
      })),
    }
  : undefined;
const suppliedSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [pageSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...suppliedSchemas];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#122633">
    <meta name="google-analytics-id" content="G-4L8SL3JCFW" data-host="mortgage.utilitas.app">
    <meta name="description" content={description}>
    <meta name="author" content="Utilitas">
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}>
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl}>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Mortgage Compass">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={imageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Mortgage Compass planning workspace">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageUrl}>
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI content index">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot name="hero" />
      {pathSegments.length > 0 && <Breadcrumbs items={breadcrumbItems} />}
      <slot />
    </main>
    <Footer />
    <aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
      <div>
        <p class="analytics-consent__kicker">Optional site analytics</p>
        <h2 id="analytics-consent-title">Help improve Mortgage Compass</h2>
        <p>Google Analytics loads only if you allow it. It receives the page path, page title, referrer origin, and ordinary device or browser information. Mortgage inputs, saved scenarios, and share-link queries are excluded. <a href="/privacy/">Read the privacy policy</a>.</p>
        <p class="analytics-consent__status" data-analytics-status aria-live="polite"></p>
      </div>
      <div class="analytics-consent__actions">
        <button type="button" data-analytics-allow>Allow analytics</button>
        <button type="button" data-analytics-deny>Do not allow</button>
      </div>
    </aside>
    <button class="analytics-settings" type="button" data-analytics-settings hidden>Analytics choices</button>
    <script is:inline src="/js/webmcp.js" defer></script>
    <script is:inline src="/js/analytics.js" defer></script>
  </body>
</html>
