---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { ARTICLES } from "../../data/articles";
import { CALCULATORS, SITE } from "../../data/site";

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const canonical = `/guides/${article.slug}/`;
const tool = CALCULATORS.find((calculator) => calculator.slug === article.calculator);
const related = ARTICLES.filter((candidate) => candidate.slug !== article.slug).slice(0, 4);
const updatedLabel = new Intl.DateTimeFormat("en-CA", {
  dateStyle: "long",
  timeZone: "UTC"
}).format(new Date(`${article.updated}T00:00:00Z`));
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.published,
  dateModified: article.updated,
  mainEntityOfPage: `${SITE.origin}${canonical}`,
  image: `${SITE.origin}/assets/mortgage-compass-card.svg`,
  author: { "@type": "Organization", name: "Utilitas", url: "https://utilitas.app" },
  publisher: { "@type": "Organization", name: "Utilitas", url: "https://utilitas.app" },
  inLanguage: "en-CA"
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer }
  }))
};
---

<BaseLayout title={article.title} description={article.description} canonical={canonical} type="article" jsonLd={[articleSchema, faqSchema]}>
  <div class="article-shell">
    <article class="article">
      <header class="article-header">
        <p class="eyebrow">{article.category}</p>
        <h1>{article.title}</h1>
        <p class="dek">{article.description}</p>
        <div class="article-meta">
          <span>By Utilitas Editorial</span>
          <span>Updated <time datetime={article.updated}>{updatedLabel}</time></span>
          <span>{article.readingMinutes} minute read</span>
          <span>Reviewed against linked primary sources</span>
        </div>
      </header>
      <div class="article-body">
        {article.intro.map((paragraph) => <p>{paragraph}</p>)}
        <AdSlot placement={`article-${article.slug}-intro`} />

        <aside class="takeaways">
          <h2>Key takeaways</h2>
          <ul>{article.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}</ul>
        </aside>

        {article.sections.map((section, index) => (
          <>
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
              {section.links && <ul>{section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
            </section>
            {(index === 0 || index === 2) && <AdSlot placement={`article-${article.slug}-section-${index + 1}`} format="rectangle" />}
          </>
        ))}

        {tool && (
          <aside class="article-cta">
            <p class="eyebrow">Make the example yours</p>
            <h2>Open the {tool.name.toLowerCase()}</h2>
            <p>{tool.description}</p>
            <a class="button" href={`/calculators/${tool.slug}/`}>Use calculator</a>
          </aside>
        )}

        <section>
          <h2>Frequently asked questions</h2>
          {article.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </section>

        <AdSlot placement={`article-${article.slug}-after-faq`} />

        <section class="sources">
          <h2>Sources and further reading</h2>
          <p>Mortgage rules and market data can change. Follow the links for current official information.</p>
          <ul>{article.sources.map((source) => <li><a href={source.href} rel="external">{source.label}</a></li>)}</ul>
        </section>
      </div>
    </article>
    <aside class="article-rail">
      <AdSlot placement={`article-${article.slug}-rail`} format="rail" />
      <div class="article-related">
        <h2>Continue planning</h2>
        {related.map((candidate) => <a href={`/guides/${candidate.slug}/`}>{candidate.title}</a>)}
      </div>
    </aside>
  </div>
</BaseLayout>
