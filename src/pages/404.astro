---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The requested Mortgage Compass page was not found." noindex>
  <section class="page-hero" slot="hero">
    <div class="page-shell">
      <p class="eyebrow">404 · Off the map</p>
      <h1>This path does not lead to a mortgage plan.</h1>
      <p>The page may have moved or the address may be incomplete.</p>
      <div class="hero-actions">
        <a class="button" href="/">Return home</a>
        <a class="button secondary" href="/calculators/">Browse calculators</a>
      </div>
    </div>
  </section>
</BaseLayout>
