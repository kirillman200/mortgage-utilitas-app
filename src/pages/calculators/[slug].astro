---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MortgageWorkbench from "../../components/MortgageWorkbench.vue";
import AdSlot from "../../components/AdSlot.astro";
import { CALCULATORS, SITE, type CalculatorSlug } from "../../data/site";
import { ARTICLES } from "../../data/articles";
import { CALCULATOR_CONTENT } from "../../data/calculator-content";

export function getStaticPaths() {
  return CALCULATORS.map((calculator) => ({
    params: { slug: calculator.slug },
    props: { calculator }
  }));
}

const { calculator } = Astro.props;
const related = ARTICLES.filter((article) => article.calculator === calculator.slug).slice(0, 3);
const canonical = `/calculators/${calculator.slug}/`;
const content = CALCULATOR_CONTENT[calculator.slug as CalculatorSlug];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: `${calculator.name} | Mortgage Compass`,
    url: `${SITE.origin}${canonical}`,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any modern web browser",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
    description: calculator.description
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: content.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }
];
---

<BaseLayout title={`${calculator.name} Calculator`} description={calculator.description} canonical={canonical} jsonLd={jsonLd}>
  <section class="page-hero" slot="hero">
    <div class="page-shell">
      <p class="eyebrow">{calculator.eyebrow}</p>
      <h1>{calculator.name}</h1>
      <p>{calculator.description} Change any assumption and the full plan recalculates instantly.</p>
    </div>
  </section>

  <div class="calculator-workspace">
    <MortgageWorkbench client:load initialMode={calculator.slug as CalculatorSlug} />
  </div>
  <AdSlot placement={`calculator-${calculator.slug}-after-results`} />

  <section class="section page-shell calculator-explainer">
    <div class="section-heading">
      <p class="eyebrow">Calculator guide</p>
      <h2>{content.heading}</h2>
      {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="card-grid calculator-reading-grid">
      <article class="tool-card">
        <span class="card-number">01</span>
        <h3>Enter a useful scenario</h3>
        <ol>{content.steps.map((step) => <li>{step}</li>)}</ol>
      </article>
      <article class="tool-card">
        <span class="card-number">02</span>
        <h3>{content.resultHeading}</h3>
        {content.resultParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    </div>
    <div class="calculator-faq">
      <p class="eyebrow">Questions answered</p>
      <h2>Frequently asked questions</h2>
      {content.faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
    <div class="calculator-sources sources">
      <h2>Official references</h2>
      <p>Rules and tax programs can change. Confirm the current requirements before acting.</p>
      <ul>{content.sources.map((source) => <li><a href={source.href} rel="external">{source.label}</a></li>)}</ul>
    </div>
  </section>

  <section class="section page-shell">
    <div class="section-heading">
      <p class="eyebrow">Use the estimate well</p>
      <h2>What this calculator can and cannot tell you</h2>
      <p>It can model transparent assumptions, compare scenarios, and expose tradeoffs. It cannot approve a loan, quote a lender, predict markets, interpret your contract, or replace licensed advice.</p>
    </div>
    <div class="card-grid">
      <article class="tool-card">
        <span class="card-number">A</span><h3>Try a range</h3><p>Run the base case, a higher rate, a lower home value, and a cash-buffer case.</p>
      </article>
      <article class="tool-card">
        <span class="card-number">B</span><h3>Check the contract</h3><p>Confirm compounding, prepayment, fees, insurance, dates, and lender rounding.</p>
      </article>
      <article class="tool-card">
        <span class="card-number">C</span><h3>Keep liquidity</h3><p>A feasible payment is not the same as a resilient household budget.</p>
      </article>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section page-shell">
      <div class="section-heading"><p class="eyebrow">Related field notes</p><h2>Understand the decision behind the number</h2></div>
      <div class="card-grid">
        {related.map((article) => (
          <a class="guide-card" href={`/guides/${article.slug}/`}>
            <span class="eyebrow">{article.category}</span><h3>{article.title}</h3><p>{article.description}</p><footer>Read guide →</footer>
          </a>
        ))}
      </div>
    </section>
  )}
  <AdSlot placement={`calculator-${calculator.slug}-bottom`} />
</BaseLayout>
