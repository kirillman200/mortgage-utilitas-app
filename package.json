{
  "name": "mortgage-utilitas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-worker-dev.mjs",
    "build": "astro build",
    "preview": "node scripts/run-worker-dev.mjs --no-watch",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "validate": "npm run check && npm run test && npm run build && npm run test:site",
    "test:site": "node --test tests/site-contract.test.mjs",
    "refresh:housing": "node scripts/refresh-housing-snapshots.mjs",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.1",
    "astro": "^7.3.2",
    "chart.js": "^4.5.1",
    "vue": "^3.5.21",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.33.1"
  }
}
